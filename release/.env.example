# Use a separate Supabase project for preview. Publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Hosted previews may omit SITE_URL to use the platform's exact VERCEL_URL.
# Initialization generates SQL for the isolated project; no service-role key is used.
# Owner must supply a monitored contact before production.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Production only: use a separate Supabase project and exact HTTPS site origin.
# Preview ignores this opt-in and always remains noindex.
GOLFER_HUB_PUBLIC_INDEXING=false
